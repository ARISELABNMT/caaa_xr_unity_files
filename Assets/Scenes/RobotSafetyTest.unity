  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"uf_robot_hardware/UFRobotSystemHardware\" type=\"system\">\r\n 
    <hardware>\r\n    <plugin>uf_robot_hardware/UFRobotSystemHardware</plugin>\r\n   
    <param name=\"hw_ns\">xarm</param>\r\n    <param name=\"velocity_control\">False</param>\r\n   
    <param name=\"prefix\">P</param>\r\n    <param name=\"robot_ip\">R</param>\r\n   
    <param name=\"report_type\">normal</param>\r\n    <param name=\"dof\">6</param>\r\n   
    <param name=\"baud_checkset\">True</param>\r\n    <param name=\"default_gripper_baud\">2000000</param>\r\n   
    <param name=\"robot_type\">lite</param>\r\n    <param name=\"add_gripper\">False</param>\r\n 
    </hardware>\r\n  <joint name=\"joint1\">\r\n    <command_interface name=\"position\">\r\n     
    <param name=\"min\">-6.283185307179586</param>\r\n      <param name=\"max\">6.283185307179586</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.14</param>\r\n      <param name=\"max\">3.14</param>\r\n    </command_interface>\r\n   
    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n    <!-- <state_interface name=\"effort\"/> -->\r\n  </joint>\r\n  <joint
    name=\"joint2\">\r\n    <command_interface name=\"position\">\r\n      <param
    name=\"min\">-2.61799</param>\r\n      <param name=\"max\">2.61799</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.14</param>\r\n      <param name=\"max\">3.14</param>\r\n    </command_interface>\r\n   
    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n    <!-- <state_interface name=\"effort\"/> -->\r\n  </joint>\r\n  <joint
    name=\"joint3\">\r\n    <command_interface name=\"position\">\r\n      <param
    name=\"min\">-0.061087</param>\r\n      <param name=\"max\">5.235988</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.14</param>\r\n      <param name=\"max\">3.14</param>\r\n    </command_interface>\r\n   
    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n    <!-- <state_interface name=\"effort\"/> -->\r\n  </joint>\r\n  <joint
    name=\"joint4\">\r\n    <command_interface name=\"position\">\r\n      <param
    name=\"min\">-6.283185307179586</param>\r\n      <param name=\"max\">6.283185307179586</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.14</param>\r\n      <param name=\"max\">3.14</param>\r\n    </command_interface>\r\n   
    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n    <!-- <state_interface name=\"effort\"/> -->\r\n  </joint>\r\n  <joint
    name=\"joint5\">\r\n    <command_interface name=\"position\">\r\n      <param
    name=\"min\">-2.1642</param>\r\n      <param name=\"max\">2.1642</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.14</param>\r\n      <param name=\"max\">3.14</param>\r\n    </command_interface>\r\n   
    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n    <!-- <state_interface name=\"effort\"/> -->\r\n  </joint>\r\n  <joint
    name=\"joint6\">\r\n    <command_interface name=\"position\">\r\n      <param
    name=\"min\">-6.283185307179586</param>\r\n      <param name=\"max\">6.283185307179586</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.14</param>\r\n      <param name=\"max\">3.14</param>\r\n    </command_interface>\r\n   
    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n    <!-- <state_interface name=\"effort\"/> -->\r\n  </joint>\r\n</ros2_control>"
